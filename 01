    }
];

// Sample borrowing history
const borrowHistory = [
    {
        title: "Introduction to Python",
        issueDate: "2026-10-01",
        returnDate: "2026-10-15"
    },
    {
        title: "Web Development Basics",
        issueDate: "2026-10-05",
        returnDate: "2026-10-19"
    }
];

// Switch between sections
function showTab(tabId) {
    document.querySelectorAll(".panel").forEach(function(panel) {
        panel.classList.add("hidden");
    });

    document.getElementById(tabId).classList.remove("hidden");
}

// Display and search books
function renderBooks() {
    const search = document.getElementById("bookSearch")
        .value.toLowerCase();

    const filteredBooks = books.filter(function(book) {
        return book.title.toLowerCase().includes(search) ||
               book.author.toLowerCase().includes(search) ||
               book.category.toLowerCase().includes(search);
    });

    const bookList = document.getElementById("bookList");

    if (filteredBooks.length === 0) {
        bookList.innerHTML = "<p>No books found.</p>";
        return;
    }

    bookList.innerHTML = filteredBooks.map(function(book) {
        return `
            <div class="card">
                <h3>${book.title}</h3>
                <p><strong>Author:</strong> ${book.author}</p>
                <p><strong>Category:</strong> ${book.category}</p>
                <button onclick="viewBook(${book.id})">
                    View Details
                </button>
            </div>
        `;
    }).join("");
}

// View book details
function viewBook(id) {
    const book = books.find(function(item) {
        return item.id === id;
    });

    if (book) {
        alert(
            "Book Details\n" +
            "Title: " + book.title + "\n" +
            "Author: " + book.author + "\n" +
            "Category: " + book.category
        );
    }
}

// Display books in admin panel
function renderAdminBooks() {
    const adminList = document.getElementById("adminBookList");

    adminList.innerHTML = books.map(function(book) {
        return `
            <div class="book-item">
                <h3>${book.title}</h3>
                <p>Author: ${book.author}</p>
                <p>Category: ${book.category}</p>

                <button onclick="editBook(${book.id})">
                    Update
                </button>

                <button onclick="deleteBook(${book.id})">
                    Delete
                </button>

                <button onclick="issueBook(${book.id})">
                    Issue Book
                </button>
            </div>
        `;
    }).join("");
}

// Add a new book
document.getElementById("bookForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const title = document.getElementById("newTitle").value.trim();
        const author = document.getElementById("newAuthor").value.trim();
        const category = document.getElementById("newCategory").value.trim();

        if (!title || !author || !category) {
            alert("Please fill in all book details.");
            return;
        }

        books.push({
            id: Date.now(),
            title: title,
            author: author,
            category: category
        });

        this.reset();

        renderBooks();
        renderAdminBooks();

        alert("Book added successfully!");
    }
);

// Update a book
function editBook(id) {
    const book = books.find(function(item) {
        return item.id === id;
    });

    if (!book) return;

    const title = prompt("Enter new book title:", book.title);
    if (title === null || title.trim() === "") return;

    const author = prompt("Enter new author:", book.author);
    if (author === null || author.trim() === "") return;

    const category = prompt("Enter new category:", book.category);
    if (category === null || category.trim() === "") return;

    book.title = title.trim();
    book.author = author.trim();
    book.category = category.trim();

    renderBooks();
    renderAdminBooks();

    alert("Book updated successfully!");
}

// Delete a book
function deleteBook(id) {
    if (!confirm("Are you sure you want to delete this book?")) {
        return;
    }

    books = books.filter(function(book) {
        return book.id !== id;
    });

    renderBooks();
    renderAdminBooks();

    alert("Book deleted successfully!");
}

// Issue a book
function issueBook(id) {
    const book = books.find(function(item) {
        return item.id === id;
    });

    if (!book) return;

    const today = new Date();
    const returnDate = new Date();

    returnDate.setDate(today.getDate() + 14);

    borrowHistory.push({
        title: book.title,
        issueDate: today.toISOString().slice(0, 10),
        returnDate: returnDate.toISOString().slice(0, 10)
    });

    renderBorrowHistory();

    alert("Book issued successfully!");
}

// Display borrowing history
function renderBorrowHistory() {
    const borrowList = document.getElementById("borrowList");

    borrowList.innerHTML = borrowHistory.map(function(item) {
        return `
            <div class="book-item">
                <strong>${item.title}</strong>
                <p>Issue Date: ${item.issueDate}</p>
                <p>Expected Return: ${item.returnDate}</p>
            </div>
        `;
    }).join("");
}

// Student registration form
document.getElementById("registerForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const name = document.getElementById("studentName").value.trim();
        const email = document.getElementById("studentEmail").value.trim();

        document.getElementById("loginMessage").textContent =
            "Welcome, " + name + "! Registration successful.";

        alert("Student registered successfully!\nEmail: " + email);
    }
);

// Calculate overdue fine at ₹5 per day
function calculateFine() {
    const days = Number(document.getElementById("lateDays").value);

    if (days < 0 || !Number.isFinite(days)) {
        alert("Enter a valid number of overdue days.");
        return;
    }

    const fine = days * 5;

    document.getElementById("fineOutput").textContent =
        "Total Fine: ₹" + fine;
}

// Filter study materials
function renderMaterials() {
    const year = document.getElementById("yearFilter").value;
    const semester = document.getElementById("semesterFilter").value;

    const filteredMaterials = materials.filter(function(material) {
        return (!year || material.year === year) &&
               (!semester || material.semester === semester);
    });

    const materialList = document.getElementById("materialList");

    if (filteredMaterials.length === 0) {
        materialList.innerHTML = "<p>No study materials found.</p>";
        return;
    }

    materialList.innerHTML = filteredMaterials.map(function(material) {
        return `
            <div class="card">
                <h3>${material.title}</h3>
                <p>Year: ${material.year}</p>
                <p>${material.semester}</p>
                <button onclick="downloadMaterial('${material.title}')">
                    Download
                </button>
            </div>
        `;
    }).join("");
}

// Download a sample study material file
function downloadMaterial(title) {
    const content = title + "\nCampus Library Study Material";
    const blob = new Blob([content], { type: "text/plain" });
    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = url;
    link.download = title.replace(/[^a-z0-9]/gi, "_") + ".txt";

    document.body.appendChild(link);
    link.click();
    link.remove();

    URL.revokeObjectURL(url);
}

// Initialize the page
renderBooks();
renderAdminBooks();
renderBorrowHistory();
renderMaterials();

