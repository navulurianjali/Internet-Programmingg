Filename: experiment4_train.js
// Train details
const trains = [
    {
        id: 1,
        name: "Chennai Express",
        number: "12603",
        source: "Chennai",
        destination: "Bangalore",
        departure: "06:00 AM",
        arrival: "12:00 PM",
        sleeper: 350,
        ac3: 750,
        ac2: 1200
    },
    {
        id: 2,
        name: "Bangalore Mail",
        number: "12609",
        source: "Chennai",
        destination: "Bangalore",
        departure: "10:30 PM",
        arrival: "05:30 AM",
        sleeper: 400,
        ac3: 850,
        ac2: 1350
    },
    {
        id: 3,
        name: "Hyderabad Superfast",
        number: "12759",
        source: "Chennai",
        destination: "Hyderabad",
        departure: "07:00 PM",
        arrival: "07:00 AM",
        sleeper: 500,
        ac3: 1000,
        ac2: 1600
    }
];

// Set the minimum journey date to today
const journeyDateInput = document.getElementById("journeyDate");

const now = new Date();

const todayString = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0")
].join("-");

journeyDateInput.min = todayString;
journeyDateInput.value = todayString;

// Display available trains
function renderTrains(list = trains) {
    const trainList = document.getElementById("trainList");

    if (list.length === 0) {
        trainList.innerHTML =
            "<p>No trains found for the selected route.</p>";
        return;
    }

    trainList.innerHTML = list.map(function(train) {
        return `
            <div class="train-card">
                <h3>🚆 ${train.name}</h3>
                <p><strong>Train Number:</strong> ${train.number}</p>
                <p><strong>Route:</strong> ${train.source} → ${train.destination}</p>
                <p><strong>Departure:</strong> ${train.departure}</p>
                <p><strong>Arrival:</strong> ${train.arrival}</p>
                <p class="train-price">From ₹${train.sleeper}</p>
                <button onclick="selectTrain(${train.id})">
                    Select Train
                </button>
            </div>
        `;
    }).join("");
}

// Search trains by source and destination
document.getElementById("searchForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const source = document.getElementById("source")
            .value.trim().toLowerCase();

        const destination = document.getElementById("destination")
            .value.trim().toLowerCase();

        const date = journeyDateInput.value;

        if (!date || date < todayString) {
            alert("Please select a valid journey date.");
            return;
        }

        const filteredTrains = trains.filter(function(train) {
            return train.source.toLowerCase() === source &&
                   train.destination.toLowerCase() === destination;
        });

        renderTrains(filteredTrains);

        document.getElementById("searchMessage").textContent =
            filteredTrains.length + " train(s) found for " +
            document.getElementById("source").value + " to " +
            document.getElementById("destination").value +
            " on " + date + ".";

        document.getElementById("trains").scrollIntoView({
            behavior: "smooth"
        });
    }
);

// Get fare based on travel class
function getFare(train, travelClass) {
    if (!train) return 0;

    if (travelClass === "AC3") {
        return train.ac3;
    }

    if (travelClass === "AC2") {
        return train.ac2;
    }

    return train.sleeper;
}

// Select a train
function selectTrain(id) {
    const train = trains.find(function(item) {
        return item.id === id;
    });

    if (!train) return;

    document.getElementById("selectedTrain").value = String(id);

    updateFare();

    document.getElementById("reservation").scrollIntoView({
        behavior: "smooth"
    });
}

// Update fare whenever train, class, or passenger count changes
function updateFare() {
    const trainId = Number(
        document.getElementById("selectedTrain").value
    );

    const train = trains.find(function(item) {
        return item.id === trainId;
    });

    const travelClass = document.getElementById("travelClass").value;

    const passengerCount = Number(
        document.getElementById("passengers").value
    ) || 0;

    const fare = getFare(train, travelClass);
    const total = fare * passengerCount;

    document.getElementById("trainName").textContent =
        train ? train.name : "Not selected";

    document.getElementById("farePerPassenger").textContent =
        "₹" + fare;

    document.getElementById("totalFare").textContent =
        "₹" + total;
}

// Update fare on input changes
document.getElementById("selectedTrain").addEventListener(
    "change", updateFare
);

document.getElementById("travelClass").addEventListener(
    "change", updateFare
);

document.getElementById("passengers").addEventListener(
    "input", updateFare
);

// Process the reservation
document.getElementById("reservationForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const trainId = Number(
            document.getElementById("selectedTrain").value
        );

        const train = trains.find(function(item) {
            return item.id === trainId;
        });

        const name = document.getElementById("passengerName")
            .value.trim();

        const age = Number(document.getElementById("age").value);

        const gender = document.getElementById("gender").value;

        const phone = document.getElementById("phone")
            .value.trim();

        const travelClass = document.getElementById("travelClass").value;

        const passengerCount = Number(
            document.getElementById("passengers").value
        );

        const journeyDate = journeyDateInput.value;

        if (!train) {
            alert("Please select a train.");
            return;
        }

        if (!name || age < 1 || age > 120 || !gender ||
            !/^[0-9]{10}$/.test(phone)) {
            alert("Please enter valid passenger details.");
            return;
        }

        if (!Number.isInteger(passengerCount) ||
            passengerCount < 1 || passengerCount > 6) {
            alert("Please enter between 1 and 6 passengers.");
            return;
        }

        if (!journeyDate || journeyDate < todayString) {
            alert("Please select a valid journey date.");
            return;
        }

        const fare = getFare(train, travelClass);
        const total = fare * passengerCount;

        const reservationId =
            "RC" + Date.now().toString().slice(-8);

        const classNames = {
            Sleeper: "Sleeper Class",
            AC3: "AC 3 Tier",
            AC2: "AC 2 Tier"
        };

        const result = document.getElementById("reservationResult");

        result.innerHTML = `
            <h3>✅ Reservation Confirmed!</h3>
            <p><strong>Reservation ID:</strong> ${reservationId}</p>
            <p><strong>Passenger Name:</strong> ${name}</p>
            <p><strong>Age:</strong> ${age}</p>
            <p><strong>Gender:</strong> ${gender}</p>
            <p><strong>Mobile Number:</strong> ${phone}</p>
            <p><strong>Train:</strong> ${train.name}</p>
            <p><strong>Train Number:</strong> ${train.number}</p>
            <p><strong>Route:</strong> ${train.source} → ${train.destination}</p>
            <p><strong>Journey Date:</strong> ${journeyDate}</p>
            <p><strong>Departure:</strong> ${train.departure}</p>
            <p><strong>Travel Class:</strong> ${classNames[travelClass]}</p>
            <p><strong>Number of Passengers:</strong> ${passengerCount}</p>
            <p><strong>Fare Per Passenger:</strong> ₹${fare}</p>
            <p><strong>Total Fare:</strong> ₹${total}</p>
            <p>Please save your reservation ID for reference.</p>
        `;

        result.classList.remove("hidden");

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

// Initialize the page
renderTrains();
updateFare();

