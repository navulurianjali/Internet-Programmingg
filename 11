const products = [
    { id: 1, name: "Rose Bouquet", category: "Flowers", price: 500 },
    { id: 2, name: "Flower Basket", category: "Flowers", price: 800 },
    { id: 3, name: "Gift Hamper", category: "Gifts", price: 1000 },
    { id: 4, name: "Chocolate Box", category: "Gifts", price: 400 },
    { id: 5, name: "Birthday Cake", category: "Cakes", price: 700 }
];

let cart = [];

function displayProducts() {
    const category = document.getElementById("category").value;
    const container = document.getElementById("products");

    const filtered = products.filter(product =>
        category === "all" || product.category === category
    );

    container.innerHTML = filtered.map(product => `
        <div class="card">
            <h3>${product.name}</h3>
            <p>Category: ${product.category}</p>
            <p>Price: ₹${product.price}</p>
            <button onclick="addToCart(${product.id})">
                Add to Cart
            </button>
        </div>
    `).join("");
}

function addToCart(id) {
    const product = products.find(item => item.id === id);
    cart.push(product);
    displayCart();
}

function displayCart() {
    const container = document.getElementById("cartItems");

    container.innerHTML = cart.map((item, index) => `
        <div class="cart-item">
            ${item.name} - ₹${item.price}
            <button onclick="removeItem(${index})">Remove</button>
        </div>
    `).join("");

    const total = cart.reduce((sum, item) => sum + item.price, 0);

    document.getElementById("total").textContent =
        "Total: ₹" + total;
}

function removeItem(index) {
    cart.splice(index, 1);
    displayCart();
}

function placeOrder() {
    const customer = document.getElementById("customer").value.trim();
    const date = document.getElementById("deliveryDate").value;
    const message = document.getElementById("message");

    if (customer === "" || date === "" || cart.length === 0) {
        message.textContent =
            "Enter your name, select a delivery date, and add products.";
        return;
    }

    if (date < new Date().toLocaleDateString("en-CA")) {
        message.textContent = "Please select a valid delivery date.";
        return;
    }

    const total = cart.reduce((sum, item) => sum + item.price, 0);

    message.textContent =
        "Order placed successfully for " + customer +
        ". Delivery date: " + date +
        ". Total amount: ₹" + total + ".";

    cart = [];
    displayCart();
}

displayProducts();

