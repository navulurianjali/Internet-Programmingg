JAVASCRIPT CODE — script.js
const properties = [
    {
        name: "Family House",
        location: "Chennai",
        type: "House",
        price: 4500000
    },
    {
        name: "Residential Land",
        location: "Bangalore",
        type: "Land",
        price: 2000000
    },
    {
        name: "Modern Apartment",
        location: "Hyderabad",
        type: "Apartment",
        price: 3500000
    },
    {
        name: "Budget House",
        location: "Chennai",
        type: "House",
        price: 2500000
    }
];

function displayProperties(list) {
    const container = document.getElementById("properties");
    const message = document.getElementById("message");

    container.innerHTML = "";
    message.textContent = "";

    if (list.length === 0) {
        message.textContent = "No matching properties found.";
        return;
    }

    list.forEach(property => {
        container.innerHTML += `
            <div class="card">
                <h3>${property.name}</h3>
                <p>Location: ${property.location}</p>
                <p>Type: ${property.type}</p>
                <p>Price: ₹${property.price.toLocaleString("en-IN")}</p>
                <button onclick="viewProperty('${property.name}')">
                    View Details
                </button>
            </div>
        `;
    });
}

function searchProperties() {
    const location = document.getElementById("location")
        .value.trim().toLowerCase();

    const type = document.getElementById("type").value;
    const budget = document.getElementById("budget").value;

    const filtered = properties.filter(property =>
        property.location.toLowerCase().includes(location) &&
        (type === "all" || property.type === type) &&
        (budget === "" || property.price <= Number(budget))
    );

    displayProperties(filtered);
}

function viewProperty(name) {
    const property = properties.find(p => p.name === name);

    alert(
        "Property: " + property.name +
        "\nLocation: " + property.location +
        "\nType: " + property.type +
        "\nPrice: ₹" + property.price.toLocaleString("en-IN")
    );
}

displayProperties(properties);

RESULT
Thus, the Home Finder website was designed and implemented successfully. Users can search for properties based on location, property type, and budget, and view the details of matching properties.
