JAVASCRIPT CODE — script.js
let calculatedPremium = 0;

function calculatePremium() {
    const policy = document.getElementById("policy").value;
    const amount = Number(document.getElementById("amount").value);

    const rates = {
        health: 0.02,
        vehicle: 0.03,
        home: 0.01
    };

    if (!Number.isFinite(amount) || amount <= 0) {
        document.getElementById("result").textContent =
            "Please enter a valid insured amount.";
        calculatedPremium = 0;
        return;
    }

    calculatedPremium = amount * rates[policy];

    document.getElementById("result").textContent =
        "Estimated Annual Premium: ₹" +
        calculatedPremium.toLocaleString("en-IN");
}

function applyPolicy() {
    const amount = Number(document.getElementById("amount").value);
    const policy = document.getElementById("policy");
    const status = document.getElementById("status");

    if (amount <= 0 || !Number.isFinite(amount) ||
        calculatedPremium <= 0) {
        status.textContent =
            "Please calculate a valid premium first.";
        return;
    }

    status.textContent =
        "Application details prepared for " +
        policy.options[policy.selectedIndex].text +
        ". Estimated premium: ₹" +
        calculatedPremium.toLocaleString("en-IN") +
        ".";
}

