5. JAVASCRIPT CODE
Filename: experiment2_hotel.js
// Room prices per night
const roomPrices = {
    Standard: 2000,
    Deluxe: 3500,
    Suite: 5000
};

// Set minimum check-in date to today
const checkinInput = document.getElementById("checkin");
const checkoutInput = document.getElementById("checkout");

const today = new Date();
const todayString = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, "0"),
    String(today.getDate()).padStart(2, "0")
].join("-");

checkinInput.min = todayString;
checkoutInput.min = todayString;

// Update checkout date when check-in changes
checkinInput.addEventListener("change", function() {
    checkoutInput.min = checkinInput.value;

    if (checkoutInput.value &&
        checkoutInput.value <= checkinInput.value) {
        checkoutInput.value = "";
    }
});

// Select a room from the room cards
function selectRoom(room, price) {
    document.getElementById("roomType").value = room;

    document.getElementById("booking").scrollIntoView({
        behavior: "smooth"
    });

    alert(room + " Room selected.\nPrice per night: ₹" + price);
}

// Validate booking details and calculate total
function getBookingDetails() {
    const name = document.getElementById("guestName").value.trim();
    const email = document.getElementById("guestEmail").value.trim();
    const room = document.getElementById("roomType").value;
    const guests = Number(document.getElementById("guests").value);
    const checkin = checkinInput.value;
    const checkout = checkoutInput.value;

    if (!name || !email || !room || !checkin || !checkout) {
        alert("Please fill in all booking details.");
        return null;
    }

    if (!roomPrices[room]) {
        alert("Please select a valid room type.");
        return null;
    }

    if (guests < 1 || guests > 4) {
        alert("Please select between 1 and 4 guests.");
        return null;
    }

    if (checkin < todayString) {
        alert("Check-in date cannot be in the past.");
        return null;
    }

    const startDate = new Date(checkin + "T00:00:00");
    const endDate = new Date(checkout + "T00:00:00");

    if (endDate <= startDate) {
        alert("Check-out date must be after check-in date.");
        return null;
    }

    const nights = Math.round(
        (endDate - startDate) / (1000 * 60 * 60 * 24)
    );

    const price = roomPrices[room];
    const total = nights * price;

    return {
        name,
        email,
        room,
        guests,
        checkin,
        checkout,
        nights,
        price,
        total
    };
}

// Calculate and display the total booking cost
function calculateTotal() {
    const booking = getBookingDetails();

    if (!booking) {
        return;
    }

    const summary = document.getElementById("priceSummary");

    summary.innerHTML = `
        <h3>Booking Price Summary</h3>
        <p><strong>Room:</strong> ${booking.room}</p>
        <p><strong>Guests:</strong> ${booking.guests}</p>
        <p><strong>Number of Nights:</strong> ${booking.nights}</p>
        <p><strong>Price Per Night:</strong> ₹${booking.price}</p>
        <p><strong>Total Amount:</strong> ₹${booking.total}</p>
    `;

    summary.classList.remove("hidden");
}

// Confirm the booking
document.getElementById("bookingForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const booking = getBookingDetails();

        if (!booking) {
            return;
        }

        const bookingId = "GS" + Date.now().toString().slice(-8);

        const result = document.getElementById("bookingResult");

        result.innerHTML = `
            <h2>✅ Booking Confirmed!</h2>
            <p>Thank you, ${booking.name}!</p>
            <p><strong>Booking ID:</strong> ${bookingId}</p>
            <p><strong>Email:</strong> ${booking.email}</p>
            <p><strong>Room Type:</strong> ${booking.room}</p>
            <p><strong>Number of Guests:</strong> ${booking.guests}</p>
            <p><strong>Check-in:</strong> ${booking.checkin}</p>
            <p><strong>Check-out:</strong> ${booking.checkout}</p>
            <p><strong>Duration:</strong> ${booking.nights} night(s)</p>
            <p><strong>Total Amount:</strong> ₹${booking.total}</p>
            <p>Your booking details have been prepared successfully.</p>
        `;

        result.classList.remove("hidden");

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

