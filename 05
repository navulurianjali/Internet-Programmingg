<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkyBook - Flight Reservation</title>
    <link rel="stylesheet" href="experiment5_flight.css">
</head>
<body>

<header>
    <h1>✈ SkyBook</h1>
    <p>Discover the world, one flight at a time.</p>
</header>

<nav>
    <a href="#search">Search Flights</a>
    <a href="#flights">Available Flights</a>
    <a href="#booking">Book Tickets</a>
</nav>

<section class="hero">
    <h2>Your Journey Begins Here</h2>
    <p>Find your flight, choose your seat class, and fly comfortably.</p>
    <a href="#search" class="hero-button">Explore Flights</a>
</section>

<main>

    <section id="search" class="section">
        <h2>Search Flights</h2>

        <form id="searchForm" class="search-form">

            <div>
                <label for="source">From</label>
                <input type="text" id="source"
                       placeholder="Departure city" required>
            </div>

            <div>
                <label for="destination">To</label>
                <input type="text" id="destination"
                       placeholder="Arrival city" required>
            </div>

            <div>
                <label for="travelDate">Travel Date</label>
                <input type="date" id="travelDate" required>
            </div>

            <button type="submit">Search Flights</button>

        </form>

        <p id="searchMessage" class="message"></p>
    </section>

    <section id="flights" class="section">
        <h2>Available Flights</h2>
        <p class="subtitle">Choose the flight that suits your journey.</p>

        <div id="flightList" class="flight-container"></div>
    </section>

    <section id="booking" class="section booking-section">
        <h2>Passenger Booking</h2>

        <form id="bookingForm">

            <div class="form-grid">

                <div>
                    <label for="selectedFlight">Select Flight</label>
                    <select id="selectedFlight" required>
                        <option value="">Choose a flight</option>
                        <option value="1">Air India Express</option>
                        <option value="2">IndiGo Airlines</option>
                        <option value="3">SpiceJet</option>
                    </select>
                </div>

                <div>
                    <label for="passengerName">Passenger Name</label>
                    <input type="text" id="passengerName"
                           placeholder="Enter full name" required>
                </div>

                <div>
                    <label for="age">Age</label>
                    <input type="number" id="age"
                           min="1" max="120" required>
                </div>

                <div>
                    <label for="gender">Gender</label>
                    <select id="gender" required>
                        <option value="">Select gender</option>
                        <option value="Female">Female</option>
                        <option value="Male">Male</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <label for="email">Email Address</label>
                    <input type="email" id="email"
                           placeholder="Enter email" required>
                </div>

                <div>
                    <label for="phone">Mobile Number</label>
                    <input type="tel" id="phone"
                           pattern="[0-9]{10}"
                           placeholder="10-digit mobile number" required>
                </div>

                <div>
                    <label for="travelClass">Travel Class</label>
                    <select id="travelClass" required>
                        <option value="Economy">Economy</option>
                        <option value="Business">Business</option>
                        <option value="First">First Class</option>
                    </select>
                </div>

                <div>
                    <label for="passengers">Number of Passengers</label>
                    <input type="number" id="passengers"
                           min="1" max="6" value="1" required>
                </div>

            </div>

            <div class="fare-box">
                <p>Selected Flight:
                    <strong id="flightName">Not selected</strong>
                </p>

                <p>Fare Per Passenger:
                    <strong id="farePerPassenger">₹0</strong>
                </p>

                <h3>Total Fare:
                    <span id="totalFare">₹0</span>
                </h3>
            </div>

            <button type="submit" class="confirm-button">
                Confirm Booking
            </button>

        </form>

        <div id="bookingResult" class="booking-result hidden"></div>
    </section>

</main>

<footer>
    <p>© 2026 SkyBook | Online Flight Reservation System</p>
</footer>

<script src="experiment5_flight.js"></script>

</body>
</html>

