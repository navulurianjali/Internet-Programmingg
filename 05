Filename: experiment5_flight.js
// Sample flight details
const flights = [
    {
        id: 1,
        name: "Air India Express",
        number: "IX-102",
        source: "Chennai",
        destination: "Delhi",
        departure: "06:30 AM",
        arrival: "09:30 AM",
        economy: 4500,
        business: 9000,
        first: 14000
    },
    {
        id: 2,
        name: "IndiGo Airlines",
        number: "6E-204",
        source: "Chennai",
        destination: "Bangalore",
        departure: "10:00 AM",
        arrival: "11:00 AM",
        economy: 2500,
        business: 6000,
        first: 10000
    },
    {
        id: 3,
        name: "SpiceJet",
        number: "SG-310",
        source: "Chennai",
        destination: "Hyderabad",
        departure: "02:00 PM",
        arrival: "03:30 PM",
        economy: 3000,
        business: 7000,
        first: 11000
    }
];

// Set minimum travel date to today
const travelDateInput = document.getElementById("travelDate");

const now = new Date();

const todayString = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0")
].join("-");

travelDateInput.min = todayString;
travelDateInput.value = todayString;

// Display flight cards
function renderFlights(list = flights) {
    const flightList = document.getElementById("flightList");

    if (list.length === 0) {
        flightList.innerHTML =
            "<p>No flights found for the selected route.</p>";
        return;
    }

    flightList.innerHTML = list.map(function(flight) {
        return `
            <div class="flight-card">
                <h3>✈ ${flight.name}</h3>
                <p><strong>Flight Number:</strong> ${flight.number}</p>
                <p><strong>Route:</strong> ${flight.source} → ${flight.destination}</p>
                <p><strong>Departure:</strong> ${flight.departure}</p>
                <p><strong>Arrival:</strong> ${flight.arrival}</p>
                <p class="flight-price">From ₹${flight.economy}</p>
                <button onclick="selectFlight(${flight.id})">
                    Select Flight
                </button>
            </div>
        `;
    }).join("");
}

// Search flights by route
document.getElementById("searchForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const source = document.getElementById("source")
            .value.trim().toLowerCase();

        const destination = document.getElementById("destination")
            .value.trim().toLowerCase();

        const date = travelDateInput.value;

        if (!date || date < todayString) {
            alert("Please select a valid travel date.");
            return;
        }

        const filteredFlights = flights.filter(function(flight) {
            return flight.source.toLowerCase() === source &&
                   flight.destination.toLowerCase() === destination;
        });

        renderFlights(filteredFlights);

        document.getElementById("searchMessage").textContent =
            filteredFlights.length + " flight(s) found for " +
            document.getElementById("source").value + " to " +
            document.getElementById("destination").value +
            " on " + date + ".";

        document.getElementById("flights").scrollIntoView({
            behavior: "smooth"
        });
    }
);

// Calculate fare according to the selected class
function getFare(flight, travelClass) {
    if (!flight) return 0;

    if (travelClass === "Business") {
        return flight.business;
    }

    if (travelClass === "First") {
        return flight.first;
    }

    return flight.economy;
}

// Select a flight
function selectFlight(id) {
    const flight = flights.find(function(item) {
        return item.id === id;
    });

    if (!flight) return;

    document.getElementById("selectedFlight").value = String(id);

    updateFare();

    document.getElementById("booking").scrollIntoView({
        behavior: "smooth"
    });
}

// Update the fare display
function updateFare() {
    const flightId = Number(
        document.getElementById("selectedFlight").value
    );

    const flight = flights.find(function(item) {
        return item.id === flightId;
    });

    const travelClass = document.getElementById("travelClass").value;

    const passengerCount = Number(
        document.getElementById("passengers").value
    ) || 0;

    const fare = getFare(flight, travelClass);
    const total = fare * passengerCount;

    document.getElementById("flightName").textContent =
        flight ? flight.name : "Not selected";

    document.getElementById("farePerPassenger").textContent =
        "₹" + fare;

    document.getElementById("totalFare").textContent =
        "₹" + total;
}

// Update fare whenever the selection changes
document.getElementById("selectedFlight").addEventListener(
    "change", updateFare
);

document.getElementById("travelClass").addEventListener(
    "change", updateFare
);

document.getElementById("passengers").addEventListener(
    "input", updateFare
);

// Confirm the flight booking
document.getElementById("bookingForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const flightId = Number(
            document.getElementById("selectedFlight").value
        );

        const flight = flights.find(function(item) {
            return item.id === flightId;
        });

        const name = document.getElementById("passengerName")
            .value.trim();

        const age = Number(document.getElementById("age").value);

        const gender = document.getElementById("gender").value;

        const email = document.getElementById("email").value.trim();

        const phone = document.getElementById("phone").value.trim();

        const travelClass = document.getElementById("travelClass").value;

        const passengerCount = Number(
            document.getElementById("passengers").value
        );

        const travelDate = travelDateInput.value;

        if (!flight) {
            alert("Please select a flight.");
            return;
        }

        if (!name || age < 1 || age > 120 || !gender ||
            !/^[0-9]{10}$/.test(phone)) {
            alert("Please enter valid passenger details.");
            return;
        }

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            alert("Please enter a valid email address.");
            return;
        }

        if (!Number.isInteger(passengerCount) ||
            passengerCount < 1 || passengerCount > 6) {
            alert("Please select between 1 and 6 passengers.");
            return;
        }

        if (!travelDate || travelDate < todayString) {
            alert("Please select a valid travel date.");
            return;
        }

        const fare = getFare(flight, travelClass);
        const total = fare * passengerCount;

        const bookingId =
            "SB" + Date.now().toString().slice(-8);

        const classNames = {
            Economy: "Economy Class",
            Business: "Business Class",
            First: "First Class"
        };

        const result = document.getElementById("bookingResult");

        result.innerHTML = `
            <h3>✅ Flight Booking Confirmed!</h3>
            <p><strong>Booking Reference:</strong> ${bookingId}</p>
            <p><strong>Passenger Name:</strong> ${name}</p>
            <p><strong>Age:</strong> ${age}</p>
            <p><strong>Gender:</strong> ${gender}</p>
            <p><strong>Email:</strong> ${email}</p>
            <p><strong>Mobile:</strong> ${phone}</p>
            <p><strong>Airline:</strong> ${flight.name}</p>
            <p><strong>Flight Number:</strong> ${flight.number}</p>
            <p><strong>Route:</strong> ${flight.source} → ${flight.destination}</p>
            <p><strong>Travel Date:</strong> ${travelDate}</p>
            <p><strong>Departure:</strong> ${flight.departure}</p>
            <p><strong>Travel Class:</strong> ${classNames[travelClass]}</p>
            <p><strong>Passengers:</strong> ${passengerCount}</p>
            <p><strong>Fare Per Passenger:</strong> ₹${fare}</p>
            <p><strong>Total Fare:</strong> ₹${total}</p>
            <p>Please save your booking reference for future reference.</p>
        `;

        result.classList.remove("hidden");

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

// Initialize the page
renderFlights();
updateFare();

