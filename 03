5. JAVASCRIPT CODE
Filename: experiment3_bus.js
// Bus details and ticket prices
const buses = [
    {
        id: 1,
        name: "Express Travels",
        type: "AC Sleeper",
        departure: "09:00 PM",
        arrival: "06:00 AM",
        price: 1200,
        from: "Chennai",
        to: "Bangalore"
    },
    {
        id: 2,
        name: "Royal Roadways",
        type: "AC Seater",
        departure: "08:00 AM",
        arrival: "02:00 PM",
        price: 750,
        from: "Chennai",
        to: "Bangalore"
    },
    {
        id: 3,
        name: "GreenLine Travels",
        type: "Non-AC Sleeper",
        departure: "10:00 PM",
        arrival: "07:00 AM",
        price: 900,
        from: "Chennai",
        to: "Hyderabad"
    }
];

let selectedSeats = [];
let currentBus = null;

// Sample booked seats for each bus
const bookedSeats = {
    1: ["S2", "S6"],
    2: ["S4", "S10"],
    3: ["S1", "S8"]
};

// Set journey date minimum to today
const journeyDateInput = document.getElementById("journeyDate");

const now = new Date();
const todayString = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0")
].join("-");

journeyDateInput.min = todayString;
journeyDateInput.value = todayString;

// Display buses
function renderBuses(list = buses) {
    const busList = document.getElementById("busList");

    if (list.length === 0) {
        busList.innerHTML = "<p>No buses found for this route.</p>";
        return;
    }

    busList.innerHTML = list.map(function(bus) {
        return `
            <div class="bus-card">
                <h3>🚌 ${bus.name}</h3>
                <p><strong>Type:</strong> ${bus.type}</p>
                <p><strong>Route:</strong> ${bus.from} → ${bus.to}</p>
                <p><strong>Departure:</strong> ${bus.departure}</p>
                <p><strong>Arrival:</strong> ${bus.arrival}</p>
                <p class="bus-price">₹${bus.price}</p>
                <button onclick="chooseBus(${bus.id})">
                    Select Bus
                </button>
            </div>
        `;
    }).join("");
}

// Search buses by route
document.getElementById("searchForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const from = document.getElementById("from")
            .value.trim().toLowerCase();

        const to = document.getElementById("to")
            .value.trim().toLowerCase();

        const date = journeyDateInput.value;

        if (!date || date < todayString) {
            alert("Please select a valid journey date.");
            return;
        }

        const filteredBuses = buses.filter(function(bus) {
            return bus.from.toLowerCase() === from &&
                   bus.to.toLowerCase() === to;
        });

        renderBuses(filteredBuses);

        document.getElementById("searchMessage").textContent =
            filteredBuses.length + " bus(es) found for " +
            document.getElementById("from").value + " to " +
            document.getElementById("to").value + " on " + date + ".";

        document.getElementById("buses").scrollIntoView({
            behavior: "smooth"
        });
    }
);

// Select a bus
function chooseBus(id) {
    currentBus = buses.find(function(bus) {
        return bus.id === id;
    });

    if (!currentBus) return;

    document.getElementById("selectedBus").value = String(id);

    selectedSeats = [];

    renderSeats();
    updateFare();

    document.getElementById("seatMessage").textContent =
        currentBus.name + " selected. Please choose your seats.";

    document.getElementById("booking").scrollIntoView({
        behavior: "smooth"
    });
}

// Update bus when selection changes
document.getElementById("selectedBus").addEventListener(
    "change",
    function() {
        const id = Number(this.value);

        currentBus = buses.find(function(bus) {
            return bus.id === id;
        }) || null;

        selectedSeats = [];

        renderSeats();
        updateFare();

        document.getElementById("bookingResult").classList.add("hidden");

        document.getElementById("seatMessage").textContent =
            currentBus
                ? currentBus.name + " selected. Please choose your seats."
                : "Please select your bus and seats.";
    }
);

// Display seat layout
function renderSeats() {
    const container = document.getElementById("seatContainer");

    if (!currentBus) {
        container.innerHTML =
            "<p>Please select a bus to view seats.</p>";
        return;
    }

    container.innerHTML = "";

    for (let i = 1; i <= 12; i++) {
        const seatName = "S" + i;
        const button = document.createElement("button");

        button.type = "button";
        button.textContent = seatName;
        button.className = "seat";

        if (bookedSeats[currentBus.id].includes(seatName)) {
            button.classList.add("booked-seat");
            button.disabled = true;
            button.title = "Already booked";
        } else {
            if (selectedSeats.includes(seatName)) {
                button.classList.add("selected-seat");
            }

            button.addEventListener("click", function() {
                toggleSeat(seatName);
            });
        }

        container.appendChild(button);
    }
}

// Select or deselect a seat
function toggleSeat(seatName) {
    if (!currentBus) return;

    if (selectedSeats.includes(seatName)) {
        selectedSeats = selectedSeats.filter(function(seat) {
            return seat !== seatName;
        });
    } else {
        selectedSeats.push(seatName);
    }

    renderSeats();
    updateFare();

    document.getElementById("seatMessage").textContent =
        selectedSeats.length > 0
            ? "Selected seats: " + selectedSeats.join(", ")
            : "Please select at least one seat.";
}

// Calculate ticket fare
function updateFare() {
    const price = currentBus ? currentBus.price : 0;
    const total = selectedSeats.length * price;

    document.getElementById("seatCount").textContent =
        selectedSeats.length;

    document.getElementById("seatPrice").textContent =
        "₹" + price;

    document.getElementById("totalFare").textContent =
        "₹" + total;
}

// Confirm booking
document.getElementById("bookingForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const busId = Number(
            document.getElementById("selectedBus").value
        );

        currentBus = buses.find(function(bus) {
            return bus.id === busId;
        }) || null;

        const name = document.getElementById("passengerName")
            .value.trim();

        const age = Number(
            document.getElementById("passengerAge").value
        );

        const phone = document.getElementById("passengerPhone")
            .value.trim();

        const journeyDate = journeyDateInput.value;

        if (!currentBus) {
            alert("Please select a bus.");
            return;
        }

        if (!name || age < 1 || age > 120 || !/^[0-9]{10}$/.test(phone)) {
            alert("Please enter valid passenger details.");
            return;
        }

        if (!journeyDate || journeyDate < todayString) {
            alert("Please select a valid journey date.");
            return;
        }

        if (selectedSeats.length === 0) {
            alert("Please select at least one seat.");
            return;
        }

        // Verify seats are still available
        const alreadyBooked = selectedSeats.some(function(seat) {
            return bookedSeats[currentBus.id].includes(seat);
        });

        if (alreadyBooked) {
            alert("One or more seats are no longer available.");
            selectedSeats = [];
            renderSeats();
            updateFare();
            return;
        }

        const total = selectedSeats.length * currentBus.price;
        const bookingId = "BG" + Date.now().toString().slice(-8);

        // Mark selected seats as booked
        bookedSeats[currentBus.id].push(...selectedSeats);

        const result = document.getElementById("bookingResult");

        result.innerHTML = `
            <h3>✅ Ticket Booking Confirmed!</h3>
            <p><strong>Booking ID:</strong> ${bookingId}</p>
            <p><strong>Passenger:</strong> ${name}</p>
            <p><strong>Age:</strong> ${age}</p>
            <p><strong>Phone:</strong> ${phone}</p>
            <p><strong>Bus:</strong> ${currentBus.name}</p>
            <p><strong>Route:</strong> ${currentBus.from} → ${currentBus.to}</p>
            <p><strong>Journey Date:</strong> ${journeyDate}</p>
            <p><strong>Departure:</strong> ${currentBus.departure}</p>
            <p><strong>Seats:</strong> ${selectedSeats.join(", ")}</p>
            <p><strong>Number of Tickets:</strong> ${selectedSeats.length}</p>
            <p><strong>Total Fare:</strong> ₹${total}</p>
            <p>Please keep your booking ID for reference.</p>
        `;

        result.classList.remove("hidden");

        selectedSeats = [];

        renderSeats();
        updateFare();

        document.getElementById("seatMessage").textContent =
            "Booking completed successfully.";

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

// Initialize the page
renderBuses();
renderSeats();
updateFare();

