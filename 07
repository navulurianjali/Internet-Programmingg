Filename: experiment7_parlour.js
// Beauty service details and prices
const services = {
    "Hair Styling": 500,
    "Facial Treatment": 800,
    "Manicure": 400,
    "Bridal Makeup": 5000
};

// Set the minimum appointment date to today
const dateInput = document.getElementById("appointmentDate");

const now = new Date();

const todayString = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0")
].join("-");

dateInput.min = todayString;
dateInput.value = todayString;

// Select a service from the service cards
function selectService(serviceName) {
    document.getElementById("service").value = serviceName;

    updatePrice();

    document.getElementById("appointment").scrollIntoView({
        behavior: "smooth"
    });
}

// Update the selected service and price
function updatePrice() {
    const serviceName = document.getElementById("service").value;

    const price = services[serviceName] || 0;

    document.getElementById("selectedService").textContent =
        serviceName || "Not selected";

    document.getElementById("servicePrice").textContent =
        "₹" + price;
}

// Update the price when the service changes
document.getElementById("service").addEventListener(
    "change", updatePrice
);

// Process appointment booking
document.getElementById("appointmentForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const name = document.getElementById("customerName")
            .value.trim();

        const phone = document.getElementById("phone").value.trim();

        const email = document.getElementById("email").value.trim();

        const serviceName = document.getElementById("service").value;

        const appointmentDate = dateInput.value;

        const appointmentTime =
            document.getElementById("appointmentTime").value;

        if (!name || !/^[0-9]{10}$/.test(phone)) {
            alert("Please enter a valid name and 10-digit mobile number.");
            return;
        }

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            alert("Please enter a valid email address.");
            return;
        }

        if (!services[serviceName]) {
            alert("Please select a beauty service.");
            return;
        }

        if (!appointmentDate || appointmentDate < todayString) {
            alert("Please select a valid appointment date.");
            return;
        }

        if (!appointmentTime) {
            alert("Please select an appointment time.");
            return;
        }

        const price = services[serviceName];

        const bookingId =
            "GLOW" + Date.now().toString().slice(-8);

        const result = document.getElementById("appointmentResult");

        result.innerHTML = `
            <h3>✅ Appointment Booked Successfully!</h3>
            <p><strong>Booking ID:</strong> ${bookingId}</p>
            <p><strong>Customer Name:</strong> ${name}</p>
            <p><strong>Mobile Number:</strong> ${phone}</p>
            <p><strong>Email:</strong> ${email}</p>
            <p><strong>Service:</strong> ${serviceName}</p>
            <p><strong>Appointment Date:</strong> ${appointmentDate}</p>
            <p><strong>Appointment Time:</strong> ${appointmentTime}</p>
            <p><strong>Service Charge:</strong> ₹${price}</p>
            <p>Thank you for choosing GlowUp Beauty Studio!</p>
        `;

        result.classList.remove("hidden");

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

// Initialize the service price
updatePrice();

