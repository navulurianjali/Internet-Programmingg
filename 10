// Shopping cart
let cart = [];

// Format prices in Indian Rupees
function formatPrice(amount) {
    return "₹" + amount.toLocaleString("en-IN");
}

// Display products with search, category, and price sorting
function displayProducts() {
    const searchText =
        document.getElementById("searchInput").value.toLowerCase();

    const selectedCategory =
        document.getElementById("categoryFilter").value;

    const sortOption =
        document.getElementById("sortFilter").value;

    let filteredProducts = products.filter(function(product) {
        const matchesSearch =
            product.name.toLowerCase().includes(searchText) ||
            product.category.toLowerCase().includes(searchText) ||
            product.description.toLowerCase().includes(searchText);

        const matchesCategory =
            selectedCategory === "All" ||
            product.category === selectedCategory;

        return matchesSearch && matchesCategory;
    });

    if (sortOption === "low") {
        filteredProducts.sort(function(a, b) {
            return a.price - b.price;
        });
    } else if (sortOption === "high") {
        filteredProducts.sort(function(a, b) {
            return b.price - a.price;
        });
    }

    const productGrid = document.getElementById("productGrid");

    productGrid.innerHTML = filteredProducts.map(function(product) {
        const sizeOptions = product.sizes.map(function(size) {
            return `<option value="${size}">${size}</option>`;
        }).join("");

        return `
            <article class="product-card">
                <div class="product-image">${product.icon}</div>

                <div class="product-details">
                    <h3>${product.name}</h3>
                    <p class="category">${product.category}</p>
                    <p class="description">${product.description}</p>

                    <label class="size-label" for="size-${product.id}">
                        Select Size
                    </label>

                    <select class="size-select" id="size-${product.id}">
                        ${sizeOptions}
                    </select>

                    <p class="product-price">${formatPrice(product.price)}</p>

                    <button class="add-button"
                        onclick="addToCart(${product.id})">
                        Add to Bag
                    </button>
                </div>
            </article>
        `;
    }).join("");

    document.getElementById("noProducts").classList.toggle(
        "hidden",
        filteredProducts.length > 0
    );
}

// Add a product and selected size to the cart
function addToCart(productId) {
    const product = products.find(function(item) {
        return item.id === productId;
    });

    if (!product) {
        return;
    }

    const size = document.getElementById("size-" + productId).value;

    const existingItem = cart.find(function(item) {
        return item.id === productId && item.size === size;
    });

    if (existingItem) {
        existingItem.quantity++;
    } else {
        cart.push({
            ...product,
            size: size,
            quantity: 1
        });
    }

    updateCart();

    alert(product.name + " (Size " + size + ") added to your bag!");
}

// Increase or decrease item quantity
function changeQuantity(productId, size, change) {
    const item = cart.find(function(product) {
        return product.id === productId && product.size === size;
    });

    if (!item) {
        return;
    }

    item.quantity += change;

    if (item.quantity <= 0) {
        cart = cart.filter(function(product) {
            return !(product.id === productId && product.size === size);
        });
    }

    updateCart();
}

// Remove a product and size combination
function removeFromCart(productId, size) {
    cart = cart.filter(function(item) {
        return !(item.id === productId && item.size === size);
    });

    updateCart();
}

// Update cart items, quantities, and totals
function updateCart() {
    const cartItems = document.getElementById("cartItems");

    const itemCount = cart.reduce(function(total, item) {
        return total + item.quantity;
    }, 0);

    document.getElementById("cartCount").textContent = itemCount;

    if (cart.length === 0) {
        cartItems.innerHTML =
            '<p class="empty-cart">Your shopping bag is empty.</p>';
    } else {
        cartItems.innerHTML = cart.map(function(item) {
            return `
                <div class="cart-item">
                    <div>
                        <h4>${item.icon} ${item.name}</h4>
                        <p>Size: ${item.size}</p>
                        <p>Price: ${formatPrice(item.price)}</p>
                        <p>Subtotal:
                            ${formatPrice(item.price * item.quantity)}
                        </p>
                    </div>

                    <div class="quantity-controls">
                        <button type="button"
                            onclick="changeQuantity(
                                ${item.id}, '${item.size}', -1
                            )">−</button>

                        <strong>${item.quantity}</strong>

                        <button type="button"
                            onclick="changeQuantity(
                                ${item.id}, '${item.size}', 1
                            )">+</button>

                        <button type="button" class="remove-button"
                            onclick="removeFromCart(
                                ${item.id}, '${item.size}'
                            )">
                            Remove
                        </button>
                    </div>
                </div>
            `;
        }).join("");
    }

    const subtotal = cart.reduce(function(total, item) {
        return total + item.price * item.quantity;
    }, 0);

    // Free delivery for orders of ₹2,000 or more
    const delivery = subtotal === 0 || subtotal >= 2000 ? 0 : 100;

    document.getElementById("subtotal").textContent =
        formatPrice(subtotal);

    document.getElementById("delivery").textContent =
        delivery === 0 && subtotal > 0
            ? "FREE"
            : formatPrice(delivery);

    document.getElementById("total").textContent =
        formatPrice(subtotal + delivery);
}

// Place order and display the order summary
document.getElementById("checkoutButton").addEventListener(
    "click",
    function() {
        if (cart.length === 0) {
            alert("Your shopping bag is empty. Add products first.");
            return;
        }

        const subtotal = cart.reduce(function(total, item) {
            return total + item.price * item.quantity;
        }, 0);

        const delivery = subtotal >= 2000 ? 0 : 100;
        const total = subtotal + delivery;

        const orderId = "SH" + Date.now().toString().slice(-8);

        const orderDetails = cart.map(function(item) {
            return `
                <p>
                    ${item.name} | Size: ${item.size} |
                    Quantity: ${item.quantity} |
                    ${formatPrice(item.price * item.quantity)}
                </p>
            `;
        }).join("");

        const orderResult = document.getElementById("orderResult");

        orderResult.innerHTML = `
            <h3>✅ Order Placed Successfully!</h3>
            <p><strong>Order ID:</strong> ${orderId}</p>

            <h4>Order Details</h4>
            ${orderDetails}

            <p><strong>Subtotal:</strong> ${formatPrice(subtotal)}</p>
            <p><strong>Delivery:</strong>
                ${delivery === 0 ? "FREE" : formatPrice(delivery)}
            </p>

            <h3>Total Amount: ${formatPrice(total)}</h3>
            <p>Thank you for shopping with StyleHub!</p>
        `;

        orderResult.classList.remove("hidden");

        // Clear the cart after checkout
        cart = [];
        updateCart();

        orderResult.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

// Search and filter event listeners
document.getElementById("searchInput").addEventListener(
    "input",
    displayProducts
);

document.getElementById("categoryFilter").addEventListener(
    "change",
    displayProducts
);

document.getElementById("sortFilter").addEventListener(
    "change",
    displayProducts
);

// Initialize the website
displayProducts();
updateCart();

