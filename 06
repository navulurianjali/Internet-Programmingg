5. JAVASCRIPT CODE
Filename: experiment6_cake.js
// Cake details and base prices per kilogram
const cakes = {
    "Chocolate Cake": 500,
    "Vanilla Cake": 400,
    "Strawberry Cake": 600,
    "Red Velvet Cake": 700
};

// Set the minimum delivery date to today
const deliveryDateInput = document.getElementById("deliveryDate");

const now = new Date();

const todayString = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0")
].join("-");

deliveryDateInput.min = todayString;
deliveryDateInput.value = todayString;

// Select a cake from the cake cards
function selectCake(cakeName) {
    document.getElementById("cakeType").value = cakeName;

    updatePrice();

    document.getElementById("order").scrollIntoView({
        behavior: "smooth"
    });
}

// Calculate cake price based on size and quantity
function updatePrice() {
    const cakeName = document.getElementById("cakeType").value;

    const size = Number(document.getElementById("cakeSize").value);

    const quantity = Number(document.getElementById("quantity").value) || 0;

    const basePrice = cakes[cakeName] || 0;

    const total = basePrice * size * quantity;

    document.getElementById("selectedCake").textContent =
        cakeName || "Not selected";

    document.getElementById("selectedSize").textContent =
        (size * 0.5) + " kg";

    document.getElementById("totalPrice").textContent =
        "₹" + total;
}

// Update price whenever order options change
document.getElementById("cakeType").addEventListener(
    "change", updatePrice
);

document.getElementById("cakeSize").addEventListener(
    "change", updatePrice
);

document.getElementById("quantity").addEventListener(
    "input", updatePrice
);

// Process cake order
document.getElementById("orderForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const cakeName = document.getElementById("cakeType").value;

        const size = Number(document.getElementById("cakeSize").value);

        const quantity = Number(document.getElementById("quantity").value);

        const message = document.getElementById("message").value.trim();

        const customerName = document.getElementById("customerName")
            .value.trim();

        const phone = document.getElementById("phone").value.trim();

        const email = document.getElementById("email").value.trim();

        const deliveryDate = deliveryDateInput.value;

        const address = document.getElementById("address").value.trim();

        if (!cakes[cakeName]) {
            alert("Please select a cake.");
            return;
        }

        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
            alert("Please select between 1 and 10 cakes.");
            return;
        }

        if (!customerName || !/^[0-9]{10}$/.test(phone) ||
            !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !address) {
            alert("Please enter valid customer and delivery details.");
            return;
        }

        if (!deliveryDate || deliveryDate < todayString) {
            alert("Please select a valid delivery date.");
            return;
        }

        const total = cakes[cakeName] * size * quantity;

        const orderId = "CAKE" + Date.now().toString().slice(-8);

        const result = document.getElementById("orderResult");

        result.innerHTML = `
            <h3>🎉 Your Cake Order Is Confirmed!</h3>
            <p><strong>Order ID:</strong> ${orderId}</p>
            <p><strong>Customer Name:</strong> ${customerName}</p>
            <p><strong>Mobile Number:</strong> ${phone}</p>
            <p><strong>Email:</strong> ${email}</p>
            <p><strong>Cake:</strong> ${cakeName}</p>
            <p><strong>Cake Size:</strong> ${size * 0.5} kg</p>
            <p><strong>Quantity:</strong> ${quantity}</p>
            <p><strong>Message on Cake:</strong> ${message || "No message"}</p>
            <p><strong>Delivery Date:</strong> ${deliveryDate}</p>
            <p><strong>Delivery Address:</strong> ${address}</p>
            <p><strong>Total Amount:</strong> ₹${total}</p>
            <p>Thank you for choosing Sweet Treats!</p>
        `;

        result.classList.remove("hidden");

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

// Initialize the price display
updatePrice();

