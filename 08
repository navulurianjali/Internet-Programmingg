Filename: experiment8_hospital.js
// Doctor details and consultation fees
const doctors = {
    "1": {
        name: "Dr. Arun Kumar",
        specialization: "Cardiologist",
        fee: 600
    },
    "2": {
        name: "Dr. Priya Sharma",
        specialization: "Dermatologist",
        fee: 500
    },
    "3": {
        name: "Dr. Rahul Reddy",
        specialization: "General Physician",
        fee: 400
    },
    "4": {
        name: "Dr. Sneha Rao",
        specialization: "Pediatrician",
        fee: 450
    }
};

// Set the minimum appointment date to today
const dateInput = document.getElementById("appointmentDate");

const now = new Date();

const todayString = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, "0"),
    String(now.getDate()).padStart(2, "0")
].join("-");

dateInput.min = todayString;
dateInput.value = todayString;

// Select a doctor from the doctor cards
function selectDoctor(doctorId) {
    document.getElementById("doctor").value = doctorId;

    updateFee();

    document.getElementById("appointment").scrollIntoView({
        behavior: "smooth"
    });
}

// Update doctor name and consultation fee
function updateFee() {
    const doctorId = document.getElementById("doctor").value;
    const doctor = doctors[doctorId];

    document.getElementById("selectedDoctor").textContent =
        doctor ? doctor.name : "Not selected";

    document.getElementById("consultationFee").textContent =
        "₹" + (doctor ? doctor.fee : 0);
}

// Update fee when the doctor changes
document.getElementById("doctor").addEventListener(
    "change", updateFee
);

// Process appointment booking
document.getElementById("appointmentForm").addEventListener(
    "submit",
    function(event) {
        event.preventDefault();

        const name = document.getElementById("patientName")
            .value.trim();

        const age = Number(document.getElementById("age").value);

        const gender = document.getElementById("gender").value;

        const phone = document.getElementById("phone").value.trim();

        const email = document.getElementById("email").value.trim();

        const doctorId = document.getElementById("doctor").value;

        const appointmentDate = dateInput.value;

        const appointmentTime =
            document.getElementById("appointmentTime").value;

        const doctor = doctors[doctorId];

        if (!name || age < 1 || age > 120 ||
            !Number.isInteger(age) || !gender ||
            !/^[0-9]{10}$/.test(phone)) {
            alert("Please enter valid patient details.");
            return;
        }

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            alert("Please enter a valid email address.");
            return;
        }

        if (!doctor) {
            alert("Please select a doctor.");
            return;
        }

        if (!appointmentDate || appointmentDate < todayString) {
            alert("Please select a valid appointment date.");
            return;
        }

        if (!appointmentTime) {
            alert("Please select an appointment time.");
            return;
        }

        const appointmentId =
            "CPH" + Date.now().toString().slice(-8);

        const result = document.getElementById("appointmentResult");

        result.innerHTML = `
            <h3>✅ Appointment Booked Successfully!</h3>
            <p><strong>Appointment ID:</strong> ${appointmentId}</p>
            <p><strong>Patient Name:</strong> ${name}</p>
            <p><strong>Age:</strong> ${age}</p>
            <p><strong>Gender:</strong> ${gender}</p>
            <p><strong>Mobile Number:</strong> ${phone}</p>
            <p><strong>Email:</strong> ${email}</p>
            <p><strong>Doctor:</strong> ${doctor.name}</p>
            <p><strong>Specialization:</strong> ${doctor.specialization}</p>
            <p><strong>Appointment Date:</strong> ${appointmentDate}</p>
            <p><strong>Appointment Time:</strong> ${appointmentTime}</p>
            <p><strong>Consultation Fee:</strong> ₹${doctor.fee}</p>
            <p>Please save your appointment ID for reference.</p>
        `;

        result.classList.remove("hidden");

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
);

// Initialize the consultation fee display
updateFee();

